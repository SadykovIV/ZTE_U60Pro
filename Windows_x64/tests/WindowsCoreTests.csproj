<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- Standalone component fixtures use their dedicated run_*.py source-linked harnesses. -->
    <Compile Remove="DiagnosticExportTests.cs" />
    <Compile Remove="FirmwareSupportTests.cs;AppReadTests.cs;CustomAgentTests.cs;GenericLinuxFeaturesTests.cs;LauncherProfileTests.cs;ScreenLocalizationTests.cs" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <Compile Include="../src/Research/*.cs" Link="Research/%(Filename)%(Extension)" />
    <Compile Include="../src/Transport/*.cs" Link="Transport/%(Filename)%(Extension)" />
    <Compile Include="../src/Core/BackupPatch*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../src/Core/ImeiCodec.cs" Link="Core/ImeiCodec.cs" />
    <Compile Include="../src/Core/AccessIdentity.cs" Link="Core/AccessIdentity.cs" />
    <Compile Include="../src/Core/AccessAgentReusePolicy.cs" Link="Core/AccessAgentReusePolicy.cs" />
    <Compile Include="../src/Core/ImeiEngine.cs" Link="Core/ImeiEngine.cs" />
    <Compile Include="../src/Core/AgentPackage.cs" Link="Core/AgentPackage.cs" />
    <Compile Include="../src/Core/OnboardingEngine.cs" Link="Core/OnboardingEngine.cs" />
    <Compile Include="../src/Core/OnboardingCleanup.cs" Link="Core/OnboardingCleanup.cs" />
    <Compile Include="../src/Core/SystemBackupManager.cs" Link="Core/SystemBackupManager.cs" />
    <Compile Include="../src/Features/FeatureCore.cs" Link="Features/FeatureCore.cs" />
    <Compile Include="../src/Features/AdbControl.cs" Link="Features/AdbControl.cs" />
    <Compile Include="../src/Features/AdbToggleTransaction.cs" Link="Features/AdbToggleTransaction.cs" />
  </ItemGroup>
</Project>
