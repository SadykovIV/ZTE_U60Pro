<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <Compile Include="../src/Transport/*.cs" Link="Transport/%(Filename)%(Extension)" />
    <Compile Include="../src/Core/BackupPatch*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../src/Core/ImeiCodec.cs" Link="Core/ImeiCodec.cs" />
    <Compile Include="../src/Core/ImeiEngine.cs" Link="Core/ImeiEngine.cs" />
    <Compile Include="../src/Core/OnboardingEngine.cs" Link="Core/OnboardingEngine.cs" />
    <Compile Include="../src/Core/SystemBackupManager.cs" Link="Core/SystemBackupManager.cs" />
    <Compile Include="../src/Features/FeatureCore.cs" Link="Features/FeatureCore.cs" />
  </ItemGroup>
</Project>
