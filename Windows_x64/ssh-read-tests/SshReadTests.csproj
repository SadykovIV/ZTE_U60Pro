<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SelfContained>false</SelfContained><NuGetAudit>false</NuGetAudit>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile sources for the host without restoring or changing the Windows publication lock. -->
    <Compile Include="../src/**/*.cs" Exclude="../src/Program.cs;../src/bin/**;../src/obj/**" />
    <EmbeddedResource Include="../Resources/Localization/en.json" LogicalName="ZteManager.Localization.en.json" />
    <Content Include="../Resources/Branding/manager-icon.png"><Link>Resources/Branding/manager-icon.png</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.12" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.12" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
