{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SadykovIV/ZTE_U60Pro/main/Catalog/verified-apps.schema.json",
  "title": "ZTE U60Pro Manager verified application approvals",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "issuedAt", "minimumManagerVersion", "apps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "issuedAt": {"type": "string", "format": "date-time"},
    "minimumManagerVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "apps": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/application"}}
  },
  "$defs": {
    "translation": {
      "type": "object", "additionalProperties": false, "required": ["ru", "en"],
      "properties": {"ru": {"type": "string", "minLength": 1, "maxLength": 2048}, "en": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "profile": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "result", "level", "evidence", "evidenceSHA256", "summary"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "result": {"const": "passed"},
        "level": {"const": "physical-modem-install-and-launch"},
        "evidence": {"type": "string", "pattern": "^evidence/", "maxLength": 200},
        "evidenceSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "summary": {"$ref": "#/$defs/translation"}
      }
    },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "installerID", "description", "firmware", "architecture", "openwrt", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
        "installerID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "description": {"$ref": "#/$defs/translation"},
        "firmware": {"$ref": "#/$defs/profile"}, "architecture": {"$ref": "#/$defs/profile"}, "openwrt": {"$ref": "#/$defs/profile"},
        "verification": {"$ref": "#/$defs/verification"}
      }
    }
  }
}
